APP_NAME=Career Intelligence Platform API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=career_intelligence
POSTGRES_USER=cip_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password

JWT_ACCESS_SECRET=replace-with-a-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-token-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=career-intelligence-platform
JWT_AUDIENCE=career-intelligence-platform-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage
RESUME_MAX_SIZE_MB=10
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=
AWS_S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Agentic AI configuration
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_TIMEOUT_SECONDS=60
AGENT_MODEL_MAX_RETRIES=2
